+fn check_duplicate_names<R: Read + Seek>(reader: &mut R) -> Result<()> {
+    let file_len = reader.seek(SeekFrom::End(0)).map_err(Error::Archive)?;
+    if file_len < 22 {
+        return Ok(());
+    }
+    let search_len = (file_len as usize).min(65536 + 22);
+    reader
+        .seek(SeekFrom::End(-(search_len as i64)))
+        .map_err(Error::Archive)?;
+    let mut buf = vec![0u8; search_len];
+    reader.read_exact(&mut buf).map_err(Error::Archive)?;
+    let Some(eocd_pos) = buf.windows(4).rposition(|w| w == [0x50, 0x4b, 0x05, 0x06]) else {
+        return Ok(());
+    };
+    if eocd_pos + 22 > buf.len() {
+        return Ok(());
+    }
+    let eocd = &buf[eocd_pos..];
+    let mut total_entries = u16::from_le_bytes([eocd[10], eocd[11]]) as usize;
+    let mut cd_offset = u32::from_le_bytes([eocd[16], eocd[17], eocd[18], eocd[19]]) as u64;
+
+    // Check for ZIP64 format (sentinel values 0xFFFF/0xFFFFFFFF or ZIP64 locator)
+    let is_zip64 = total_entries == 0xffff
+        || cd_offset == 0xffffffff
+        || (eocd_pos >= 20 && buf[eocd_pos - 20..eocd_pos - 16] == [0x50, 0x4b, 0x06, 0x07]);
+
+    if is_zip64 {
+        let locator_start = eocd_pos.saturating_sub(32);
+        let Some(loc_rel) = buf[locator_start..eocd_pos]
+            .windows(4)
+            .rposition(|w| w == [0x50, 0x4b, 0x06, 0x07])
+        else {
+            return Err(Error::Archive(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "missing ZIP64 locator in ZIP64 archive",
+            )));
+        };
+        let loc_pos = locator_start + loc_rel;
+        if loc_pos + 20 > buf.len() {
+            return Err(Error::Archive(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "truncated ZIP64 locator",
+            )));
+        }
+        let loc = &buf[loc_pos..];
+        let zip64_eocd_offset = u64::from_le_bytes([
+            loc[8], loc[9], loc[10], loc[11], loc[12], loc[13], loc[14], loc[15],
+        ]);
+
+        reader
+            .seek(SeekFrom::Start(zip64_eocd_offset))
+            .map_err(Error::Archive)?;
+        let mut zip64_eocd = [0u8; 56];
+        reader.read_exact(&mut zip64_eocd).map_err(Error::Archive)?;
+        if zip64_eocd[0..4] != [0x50, 0x4b, 0x06, 0x06] {
+            return Err(Error::Archive(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "invalid ZIP64 end of central directory signature",
+            )));
+        }
+        let entries_u64 = u64::from_le_bytes([
+            zip64_eocd[32],
+            zip64_eocd[33],
+            zip64_eocd[34],
+            zip64_eocd[35],
+            zip64_eocd[36],
+            zip64_eocd[37],
+            zip64_eocd[38],
+            zip64_eocd[39],
+        ]);
+        total_entries = usize::try_from(entries_u64).map_err(|_| Error::ResourceLimit {
+            detail: format!("ZIP64 entry count {entries_u64} overflows address space"),
+        })?;
+        cd_offset = u64::from_le_bytes([
+            zip64_eocd[48],
+            zip64_eocd[49],
+            zip64_eocd[50],
+            zip64_eocd[51],
+            zip64_eocd[52],
+            zip64_eocd[53],
+            zip64_eocd[54],
+            zip64_eocd[55],
+        ]);
+    }
+
+    if total_entries > MAX_ARCHIVE_ENTRIES {
+        return Err(Error::ResourceLimit {
+            detail: format!(
+                "archive entry count {} exceeds maximum {}",
+                total_entries, MAX_ARCHIVE_ENTRIES
+            ),
+        });
+    }
+
+    reader
+        .seek(SeekFrom::Start(cd_offset))
+        .map_err(Error::Archive)?;
+    let mut seen =
+        std::collections::HashSet::with_capacity(total_entries.min(MAX_ARCHIVE_ENTRIES + 1));
+    for _ in 0..total_entries {
+        let mut header = [0u8; 46];
+        reader.read_exact(&mut header).map_err(Error::Archive)?;
+        if header[0..4] != [0x50, 0x4b, 0x01, 0x02] {
+            return Err(Error::Archive(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "corrupt or incomplete central directory header",
+            )));
+        }
+        let name_len = u16::from_le_bytes([header[28], header[29]]) as usize;
+        let extra_len = u16::from_le_bytes([header[30], header[31]]) as i64;
+        let comment_len = u16::from_le_bytes([header[32], header[33]]) as i64;
+        let mut name_bytes = vec![0u8; name_len];
+        reader.read_exact(&mut name_bytes).map_err(Error::Archive)?;
+        let name = String::from_utf8_lossy(&name_bytes).to_string();
+        if !seen.insert(name.clone()) {
+            return Err(Error::UnsafeEntry {
+                path: name,
+                detail: "duplicate entry name in archive".to_string(),
+            });
+        }
+        reader
+            .seek(SeekFrom::Current(extra_len + comment_len))
+            .map_err(Error::Archive)?;
+    }
+    Ok(())
 }
 
