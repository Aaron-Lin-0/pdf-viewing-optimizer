+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::io::Write;
+    use zip::write::SimpleFileOptions;
+
+    fn build_zip(entries: &[(&str, &[u8])]) -> Vec<u8> {
+        let mut cur = io::Cursor::new(Vec::new());
+        {
+            let mut writer = zip::ZipWriter::new(&mut cur);
+            let opts =
+                SimpleFileOptions::default().compression_method(zip::CompressionMethod::Stored);
+            for &(name, data) in entries {
+                writer.start_file(name, opts).unwrap();
+                writer.write_all(data).unwrap();
+            }
+            writer.finish().unwrap();
+        }
+        cur.into_inner()
+    }
+
+    #[test]
+    fn validates_entry_names_rejects_unsafe_paths() {
+        assert!(validate_entry_name("safe/path/file.txt").is_ok());
+        assert!(matches!(
+            validate_entry_name(""),
+            Err(Error::UnsafeEntry { .. })
+        ));
+        assert!(matches!(
+            validate_entry_name("/root/file"),
+            Err(Error::UnsafeEntry { .. })
+        ));
+        assert!(matches!(
+            validate_entry_name("\\root\\file"),
+            Err(Error::UnsafeEntry { .. })
+        ));
+        assert!(matches!(
+            validate_entry_name("C:\\windows\\system32"),
+            Err(Error::UnsafeEntry { .. })
+        ));
+        assert!(matches!(
+            validate_entry_name("path/../traversal"),
+            Err(Error::UnsafeEntry { .. })
+        ));
+        assert!(matches!(
+            validate_entry_name("has\0null"),
+            Err(Error::UnsafeEntry { .. })
+        ));
+    }
+
+    #[test]
+    fn open_rejects_duplicate_entry_names() {
+        let mut zip_bytes = build_zip(&[("file1", b"1"), ("file2", b"2")]);
+        // Mutate the second entry name to match the first, creating duplicate names in a valid ZIP.
+        for i in 0..zip_bytes.len().saturating_sub(4) {
+            if &zip_bytes[i..i + 5] == b"file2" {
+                zip_bytes[i..i + 5].copy_from_slice(b"file1");
+            }
+        }
+        let res = Container::open(io::Cursor::new(zip_bytes));
+        assert!(
+            matches!(res, Err(Error::UnsafeEntry { detail, .. }) if detail.contains("duplicate"))
+        );
+    }
+
+    #[test]
+    fn open_rejects_duplicate_entry_names_zip64() {
+        let mut cur = io::Cursor::new(Vec::new());
+        {
+            let mut writer = zip::ZipWriter::new(&mut cur);
+            let opts = SimpleFileOptions::default()
+                .compression_method(zip::CompressionMethod::Stored)
+                .large_file(true);
+            for &(name, data) in &[("file1", b"1"), ("file2", b"2")] {
+                writer.start_file(name, opts).unwrap();
+                writer.write_all(data).unwrap();
+            }
+            writer.finish().unwrap();
+        }
+        let mut zip_bytes = cur.into_inner();
+        for i in 0..zip_bytes.len().saturating_sub(4) {
+            if &zip_bytes[i..i + 5] == b"file2" {
+                zip_bytes[i..i + 5].copy_from_slice(b"file1");
+            }
+        }
+        let res = Container::open(io::Cursor::new(zip_bytes));
+        assert!(
+            matches!(res, Err(Error::UnsafeEntry { detail, .. }) if detail.contains("duplicate"))
+        );
+    }
+
+    #[test]
+    fn open_reads_valid_entries() {
+        let zip_bytes = build_zip(&[
+            ("note/pb/note_info", b"metadata"),
+            ("point/p1#points", b"points"),
+        ]);
+        let container = Container::open(io::Cursor::new(zip_bytes)).expect("open succeeds");
+        assert_eq!(
+            container.get("note/pb/note_info"),
+            Some(b"metadata".as_slice())
+        );
+        assert_eq!(container.get("point/p1#points"), Some(b"points".as_slice()));
+    }
+
+    #[test]
+    fn nested_zip_single_requires_exactly_one_file() {
+        let empty_zip = build_zip(&[]);
+        assert!(read_nested_zip_single(&empty_zip).is_err());
+
+        let multi_zip = build_zip(&[("file1", b"data1"), ("file2", b"data2")]);
+        assert!(read_nested_zip_single(&multi_zip).is_err());
+
+        let single_zip = build_zip(&[("shape_data", b"protobuf")]);
+        let bytes = read_nested_zip_single(&single_zip).expect("single entry succeeds");
+        assert_eq!(bytes, b"protobuf");
+    }
+}
