+                g: 0,
+                b: 0,
+                a: 1.0,
+            },
+            pen_type,
+            charcoal_texture: 1,
+            flat_marker: false,
+            stroke_width_config: StrokeWidthConfig::Upstream,
+        }
+    }
+
+    #[test]
+    fn strict_preserves_close_points_bypassing_decimate() {
+        // 10 points spaced by 0.04 pt (total span 0.36 pt < MIN_STEP = 0.6) with constant pressure.
+        let pts: Vec<points::Point> = (0..10)
+            .map(|i| test_point(10.0 + i as f32 * 0.04, 20.0, 2000, i * 5))
+            .collect();
+        let stroke = test_stroke(2, pts);
+        let canvas = test_canvas();
+
+        // Default mode: decimate drops all intermediate points because total span < 0.6 and dp == 0.
+        let mut b_default = CaptureBackend::default();
+        draw(&mut b_default, &canvas, &stroke);
+        assert_eq!(b_default.polylines.len(), 1);
+        assert_eq!(
+            b_default.polylines[0].0.len(),
+            2,
+            "default mode should decimate to only endpoints"
+        );
+
+        // Strict mode: all 10 points are preserved!
+        let mut b_strict = CaptureBackend::default();
+        draw_strict(&mut b_strict, &canvas, &stroke).expect("strict draw succeeds");
+        assert_eq!(b_strict.polylines.len(), 1);
+        assert_eq!(
+            b_strict.polylines[0].0.len(),
+            10,
+            "strict mode must preserve all 10 recorded points"
+        );
+    }
+
+    #[test]
+    fn strict_preserves_single_dot_for_all_supported_pens() {
+        let canvas = test_canvas();
+        for &pen_type in &[2, 5, 15, 21, 60, 61, 2000] {
+            let pts = vec![test_point(150.0, 250.0, 2048, 0)];
+            let stroke = test_stroke(pen_type, pts);
+            let mut b = CaptureBackend::default();
+            draw_strict(&mut b, &canvas, &stroke)
+                .unwrap_or_else(|e| panic!("pen {pen_type} dot failed: {e}"));
+            assert!(
+                !b.fill_rings.is_empty(),
+                "single point for pen {pen_type} must render as a filled dot"
+            );
+        }
+    }
+
+    #[test]
+    fn strict_preserves_raw_points_and_pressure_in_neo_brush_bypassing_decimate_pairs() {
+        // 20 points spaced by 0.1 pt with small pressure variations.
+        let pts: Vec<points::Point> = (0..20)
+            .map(|i| test_point(50.0 + i as f32 * 0.1, 50.0, 2000 + (i as u16 * 10), i * 3))
+            .collect();
+        let stroke = test_stroke(21, pts);
+        let canvas = test_canvas();
+
+        // Default mode: decimate_pairs reduces the number of segments.
+        let mut b_default = CaptureBackend::default();
+        draw(&mut b_default, &canvas, &stroke);
+        let default_segs = b_default.polylines.len();
+
+        // Strict mode: decimate_pairs is bypassed; 20 points produce exactly 19 segments.
+        let mut b_strict = CaptureBackend::default();
+        draw_strict(&mut b_strict, &canvas, &stroke).expect("strict neo brush draw succeeds");
+        let strict_segs = b_strict.polylines.len();
+
+        assert_eq!(
+            strict_segs, 19,
+            "strict neo_brush must retain every consecutive segment (19 segments for 20 points)"
+        );
+        assert!(
+            default_segs < strict_segs,
+            "default decimated {default_segs} segments should be less than strict {strict_segs}"
+        );
+    }
+
+    #[test]
+    fn strict_rejects_charcoal_and_unknown_pens() {
+        let canvas = test_canvas();
+        let pts = vec![
+            test_point(10.0, 10.0, 2000, 0),
+            test_point(20.0, 20.0, 2000, 10),
+        ];
+
+        // Charcoal (22): textured/raster pen must be rejected.
+        let stroke_charcoal = test_stroke(22, pts.clone());
+        let mut b1 = CaptureBackend::default();
+        let res = draw_strict(&mut b1, &canvas, &stroke_charcoal);
+        assert!(
+            matches!(res, Err(Error::UnsupportedPen { pen_type: 22 })),
+            "strict mode must reject charcoal pen 22: {res:?}"
+        );
+        assert_eq!(b1.inline_images, 0, "no raster image should be drawn");
+
+        // Unknown pen 999: must be rejected (no fallback to constant width).
+        let stroke_unknown = test_stroke(999, pts.clone());
+        let mut b2 = CaptureBackend::default();
+        let res = draw_strict(&mut b2, &canvas, &stroke_unknown);
+        assert!(
+            matches!(res, Err(Error::UnsupportedPen { pen_type: 999 })),
+            "strict mode must reject unknown pen 999: {res:?}"
+        );
+        assert!(b2.polylines.is_empty(), "no fallback polyline drawn");
+
+        // History pen 2000: supported vector pen (constant width polyline).
+        let stroke_history = test_stroke(2000, pts);
+        let mut b3 = CaptureBackend::default();
+        let res = draw_strict(&mut b3, &canvas, &stroke_history);
+        assert!(
+            res.is_ok(),
+            "strict mode must support history pen 2000: {res:?}"
+        );
+        assert_eq!(
+            b3.polylines.len(),
+            1,
+            "history pen 2000 renders as constant width polyline"
+        );
+    }
+
+    #[test]
+    fn default_mode_retains_fallback_and_rasterization_compatibility() {
+        let canvas = test_canvas();
+        let pts = vec![
+            test_point(10.0, 10.0, 2000, 0),
+            test_point(30.0, 30.0, 2000, 10),
+        ];
+
+        // Unknown pen 999 falls back to constant width in default mode.
+        let stroke_unknown = test_stroke(999, pts);
+        let mut b = CaptureBackend::default();
+        draw(&mut b, &canvas, &stroke_unknown);
+        assert_eq!(
+            b.polylines.len(),
+            1,
