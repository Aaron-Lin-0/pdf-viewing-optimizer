+/// Conservative envelope of the same configured width and nib models used for drawing.
+pub(crate) fn configured_visual_pad(
+    pen: i64,
+    nominal: f32,
+    points: &[Point],
+    config: crate::model::StrokeWidthConfig,
+) -> f32 {
+    use crate::model::StrokeWidthConfig;
+    if matches!(config, StrokeWidthConfig::Upstream) {
+        return stroke_visual_pad(pen, nominal, points);
+    }
+    let width = config.resolve_width(nominal).max(0.001);
+    match pen {
+        60 | 61 => {
+            let half_l = width / 2.0;
+            half_l.hypot((half_l / nominal.clamp(1.0, 10.0)).max(0.0005))
+        }
+        5 | 21 => {
+            let full_width = match config {
+                StrokeWidthConfig::Fixed(w) => w,
+                StrokeWidthConfig::Scale(scale) => {
+                    2.0 * stroke_visual_pad(pen, nominal, points) * scale
+                }
+                StrokeWidthConfig::DeviceNative if pen == 21 => 2.0 * nominal * 0.24 + 3.0,
+                _ => width,
+            };
+            full_width.max(0.001) / 2.0
+        }
+        22 => stroke_visual_pad(pen, width, points),
+        _ => width / 2.0,
+    }
+}
