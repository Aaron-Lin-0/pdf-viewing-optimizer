+/// Stroke width configuration mode.
+///
+/// Controls how nominal stroke widths in note shapes are mapped to rendered widths:
+/// - `Upstream`: Baseline empirical curve for fountain/nBrush, exact drawing helper floors.
+/// - `DeviceNative`: 0.24 density conversion ratio (72/300 pt/px) with natural pressure modulation.
+/// - `Fixed(w)`: Fixed stroke width `w` in points across ink strokes, ignoring pressure.
+/// - `Scale(s)`: Linear multiplier `s` applied across baseline rendered stroke widths.
+#[derive(Debug, Clone, Copy, PartialEq, Default)]
+#[non_exhaustive]
+pub enum StrokeWidthConfig {
+    /// Baseline rendering (the default).
+    #[default]
+    Upstream,
+    /// Physical density-converted width (`nominal * 0.24 pt/px`) with natural pressure modulation.
+    DeviceNative,
+    /// Constant stroke thickness in points across ink strokes.
+    Fixed(f32),
+    /// Uniform linear scaling factor applied across rendered stroke widths.
+    Scale(f32),
+}
+
+impl StrokeWidthConfig {
+    /// Whether this configuration differs from the upstream baseline.
+    pub fn is_custom(&self) -> bool {
+        !matches!(self, StrokeWidthConfig::Upstream)
+    }
+
+    /// Resolve a constant or base stroke width from nominal width.
+    pub fn resolve_width(&self, nominal: f32) -> f32 {
+        match self {
+            StrokeWidthConfig::Upstream => nominal,
+            StrokeWidthConfig::DeviceNative => nominal * 0.24,
+            StrokeWidthConfig::Fixed(w) => *w,
+            StrokeWidthConfig::Scale(s) => nominal * s,
+        }
+    }
+}
+
+/// Parse a stroke width string with optional unit suffix (`mm`, `pt`, `px`, or unitless float).
+///
+/// Supported units:
+/// - `mm`: Millimeters, converted as `val * 72.0 / 25.4` pt.
+/// - `pt`: PDF typographic points (1.0 pt/unit).
+/// - `px`: Device pixels at 300 DPI, converted as `val * 0.24` pt (72.0 / 300.0).
+/// - Unitless float: Interpreted as points.
+///
+/// Validates that the resulting value is strictly positive, finite, and within `0.001` to `100.0` pt.
+pub fn parse_stroke_width(s: &str) -> std::result::Result<f32, String> {
+    let s_trimmed = s.trim();
+    if s_trimmed.is_empty() {
+        return Err("empty stroke width string".to_string());
+    }
+    let lower = s_trimmed.to_ascii_lowercase();
+    let (num_str, factor) = if lower.ends_with("mm") {
+        (&s_trimmed[..s_trimmed.len() - 2], 72.0 / 25.4)
+    } else if lower.ends_with("pt") {
+        (&s_trimmed[..s_trimmed.len() - 2], 1.0)
+    } else if lower.ends_with("px") {
+        (&s_trimmed[..s_trimmed.len() - 2], 0.24)
+    } else {
+        (s_trimmed, 1.0)
+    };
+
+    let val: f32 = num_str
+        .trim()
+        .parse()
+        .map_err(|e| format!("invalid stroke width value '{s}': {e}"))?;
+
+    let pt = val * factor;
+    if !pt.is_finite() || pt <= 0.0 || pt < 0.001 || pt > 100.0 {
+        return Err(format!(
+            "Invalid stroke width '{s}': value must be strictly positive, finite, and between 0.001 pt and 100 pt (got {pt:.4} pt)"
+        ));
+    }
