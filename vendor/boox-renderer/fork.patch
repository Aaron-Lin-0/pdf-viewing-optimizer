+/// Render the selected note pages to a single (multi-page) PDF in strict mode.
+/// Disables automatic font downloads, enforces complete font and content accounting,
+/// and preserves raw points without decimation for supported vector strokes.
+pub fn render_pdf_strict(
+    doc: &Document,
+    font_opts: &FontOptions,
+    sel: PageSel,
+) -> crate::error::Result<Vec<u8>> {
+    if font_opts.download {
+        return Err(crate::error::Error::UnsupportedFeature {
+            feature: "automatic font downloads are disabled in strict mode".to_string(),
+        });
+    }
+    let selected = selected_pages(doc.canvases.len(), sel)?;
+    let db = font_opts.build_db();
+    let subsets = fonts::used_chars(&db, selected.iter().map(|(_, ci)| &doc.canvases[*ci]));
+    let mut be = PdfBackend::new_with_mode(doc, &selected, subsets, true)?;
+    let mut pages = Vec::new();
+    for (_suffix, ci) in &selected {
+        let canvas = &doc.canvases[*ci];
+        be.begin_page();
+        super::paint_canvas_strict(&mut be, canvas, *ci, &db)?;
+        pages.push(be.end_page(canvas));
+    }
+    Ok(be.finish(pages))
+}
