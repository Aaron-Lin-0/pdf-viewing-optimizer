+/// A filled disc (n-gon) in global coords, for lone-point dots.
+/// In upstream mode: circumscribed so flats reach `r.max(0.3)`.
+/// In custom mode: radius reaches `r.max(0.0005)` without circumscription exceeding `r`.
+fn dot(cx: f32, cy: f32, r: f32, is_custom: bool) -> Vec<(f32, f32)> {
+    if !is_custom {
+        let r = r.max(0.3);
+        let sides = if r > 6.0 { 16 } else { 8 };
+        let rr = r / (std::f32::consts::PI / sides as f32).cos();
+        (0..sides)
+            .map(|k| {
+                let t = std::f32::consts::TAU * (k as f32) / sides as f32;
+                (cx + rr * t.cos(), cy + rr * t.sin())
+            })
+            .collect()
+    } else {
+        let r = r.max(0.0005);
+        let sides = if r > 6.0 { 16 } else { 8 };
+        (0..sides)
+            .map(|k| {
+                let t = std::f32::consts::TAU * (k as f32) / sides as f32;
+                (cx + r * t.cos(), cy + r * t.sin())
+            })
+            .collect()
+    }
 }
 
