+
+    #[test]
+    fn lone_dot_geometry_upstream_vs_custom() {
+        let canvas = test_canvas();
+        let pt = vec![test_point(100.0, 100.0, 2048, 0)];
+
+        // Upstream mode with nominal width 0.01 pt:
+        // Radius is clamped to 0.3 pt, and circumscribed (rr = 0.3 / cos(pi/12) ≈ 0.31058 pt)
+        let mut stroke_upstream = test_stroke(2, pt.clone());
+        stroke_upstream.width = 0.01;
+        stroke_upstream.stroke_width_config = StrokeWidthConfig::Upstream;
+        let mut b_upstream = CaptureBackend::default();
+        draw(&mut b_upstream, &canvas, &stroke_upstream);
+        assert_eq!(b_upstream.fill_rings.len(), 1);
+        let ring_upstream = &b_upstream.fill_rings[0];
+        assert_eq!(ring_upstream.len(), 8);
+        for &(vx, vy) in ring_upstream {
+            let dist = ((vx - 100.0).powi(2) + (vy - 100.0).powi(2)).sqrt();
+            assert!(
+                dist > 0.3,
+                "upstream dot must clamp to at least 0.3 pt and circumscribe: got {dist}"
+            );
+        }
+
+        // Custom mode with Fixed(0.01 pt):
+        // Radius must be half the requested width (0.005 pt), 0.3 pt clamp removed,
+        // and non-circumscribed: vertices must NOT exceed the requested radius 0.005 pt.
+        let mut stroke_custom = test_stroke(2, pt);
+        stroke_custom.width = 0.01;
+        stroke_custom.stroke_width_config = StrokeWidthConfig::Fixed(0.01);
+        let mut b_custom = CaptureBackend::default();
+        draw(&mut b_custom, &canvas, &stroke_custom);
+        assert_eq!(b_custom.fill_rings.len(), 1);
+        let ring_custom = &b_custom.fill_rings[0];
+        assert_eq!(ring_custom.len(), 8);
+        for &(vx, vy) in ring_custom {
+            let dist = ((vx - 100.0).powi(2) + (vy - 100.0).powi(2)).sqrt();
+            assert!(
+                (dist - 0.005).abs() < 1e-5,
+                "custom dot radius must be exactly half requested width (0.005 pt) and not circumscribe: got {dist}"
+            );
+            assert!(
+                dist <= 0.005001,
+                "custom dot vertices must not exceed requested radius: got {dist}"
+            );
+        }
+    }
+
+    #[test]
+    fn fountain_pen_width_modes() {
+        let canvas = test_canvas();
+        let pts = vec![
+            test_point(10.0, 10.0, 500, 0),
+            test_point(20.0, 20.0, 2048, 10),
+            test_point(30.0, 30.0, 4000, 20),
+        ];
+
+        // 1. Upstream mode: pressure-curved widths
+        let stroke_up = test_stroke(5, pts.clone());
+        let mut b_up = CaptureBackend::default();
+        draw_strict(&mut b_up, &canvas, &stroke_up).unwrap();
+        assert_eq!(b_up.polylines.len(), 2);
+        let w_up_0 = b_up.polylines[0].1;
+        let w_up_1 = b_up.polylines[1].1;
+        assert!(w_up_0 > 0.0 && w_up_1 > 0.0);
+
+        // 2. Fixed mode (0.05 pt): constant width regardless of pressure
+        let mut stroke_fixed = test_stroke(5, pts.clone());
+        stroke_fixed.stroke_width_config = StrokeWidthConfig::Fixed(0.05);
+        let mut b_fixed = CaptureBackend::default();
+        draw_strict(&mut b_fixed, &canvas, &stroke_fixed).unwrap();
+        assert_eq!(b_fixed.polylines.len(), 2);
+        assert!((b_fixed.polylines[0].1 - 0.05).abs() < 1e-4);
+        assert!((b_fixed.polylines[1].1 - 0.05).abs() < 1e-4);
+
+        // 3. DeviceNative mode: base_pt = nominal * 0.24 = 3.0 * 0.24 = 0.72 pt
+        let mut stroke_native = test_stroke(5, pts.clone());
+        stroke_native.stroke_width_config = StrokeWidthConfig::DeviceNative;
+        let mut b_native = CaptureBackend::default();
+        draw_strict(&mut b_native, &canvas, &stroke_native).unwrap();
+        assert_eq!(b_native.polylines.len(), 2);
+        assert!(b_native.polylines[0].1 < b_native.polylines[1].1);
+        assert!(b_native.polylines[0].1 < 1.0);
+
+        // 4. Scale mode (0.5): exactly upstream widths * 0.5
+        let mut stroke_scale = test_stroke(5, pts);
+        stroke_scale.stroke_width_config = StrokeWidthConfig::Scale(0.5);
+        let mut b_scale = CaptureBackend::default();
+        draw_strict(&mut b_scale, &canvas, &stroke_scale).unwrap();
+        assert_eq!(b_scale.polylines.len(), 2);
+        assert!((b_scale.polylines[0].1 - w_up_0 * 0.5).abs() < 1e-4);
+        assert!((b_scale.polylines[1].1 - w_up_1 * 0.5).abs() < 1e-4);
+    }
+
+    #[test]
+    fn calligraphy_width_modes() {
+        let canvas = test_canvas();
+        let pts = vec![
+            test_point(10.0, 10.0, 2048, 0),
+            test_point(20.0, 20.0, 2048, 10),
+        ];
+
+        // Upstream mode with nominal 0.01 pt: clamped to 0.3 pt
+        let mut stroke_up = test_stroke(60, pts.clone());
+        stroke_up.width = 0.01;
+        stroke_up.stroke_width_config = StrokeWidthConfig::Upstream;
+        let mut b_up = CaptureBackend::default();
+        draw_strict(&mut b_up, &canvas, &stroke_up).unwrap();
+        assert!(!b_up.fill_rings.is_empty());
+
+        // Custom mode: Fixed(0.01 pt) removes 0.3 pt clamp
+        let mut stroke_custom = test_stroke(60, pts);
+        stroke_custom.width = 0.01;
+        stroke_custom.stroke_width_config = StrokeWidthConfig::Fixed(0.01);
+        let mut b_custom = CaptureBackend::default();
+        draw_strict(&mut b_custom, &canvas, &stroke_custom).unwrap();
+        assert!(!b_custom.fill_rings.is_empty());
+    }
+
+    #[test]
+    fn configured_single_canvas_contains_rendered_ink() {
+        use crate::model::{Document, Layout, RenderItem};
+        for pen in [2, 5, 15, 21, 60, 61, 2000] {
+            for config in [
+                StrokeWidthConfig::Fixed(100.0),
+                StrokeWidthConfig::Scale(100.0),
+                StrokeWidthConfig::DeviceNative,
+                StrokeWidthConfig::Upstream,
+            ] {
+                for layout in [Layout::SingleCanvas, Layout::PerPage] {
+                    let mut stroke = test_stroke(pen, vec![test_point(0.0, 0.0, 4095, 0)]);
+                    stroke.width = 1.0;
+                    let mut canvas = test_canvas();
+                    canvas.items.push(RenderItem::Stroke(stroke));
+                    let mut doc = Document {
+                        canvases: vec![canvas],
+                    };
+                    doc.apply_stroke_width_config(config, layout);
+                    let canvas = &doc.canvases[0];
+                    if !config.is_custom() || matches!(layout, Layout::PerPage) {
+                        assert_eq!(canvas.width, 1000.0);
+                        assert_eq!(canvas.origin_x, 0.0);
+                        continue;
+                    }
+                    let RenderItem::Stroke(stroke) = &canvas.items[0] else {
+                        panic!("stroke missing")
+                    };
+                    let mut capture = CaptureBackend::default();
+                    draw_strict(&mut capture, canvas, stroke).unwrap();
+                    for ring in capture.fill_rings {
+                        for (x, y) in ring {
+                            assert!(x >= canvas.origin_x && x <= canvas.origin_x + canvas.width);
+                            assert!(y >= canvas.origin_y && y <= canvas.origin_y + canvas.height);
+                        }
+                    }
+                    if pen == 2 && matches!(config, StrokeWidthConfig::Fixed(_)) {
+                        assert_eq!(canvas.width, 148.0);
+                        assert_eq!(canvas.height, 148.0);
+                    }
+                }
+            }
+        }
+    }
 }
