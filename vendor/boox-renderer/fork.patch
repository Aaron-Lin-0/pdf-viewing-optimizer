+/// Validate that an archive entry name does not contain path traversal,
+/// absolute prefixes, drive letters, control characters, or NUL bytes.
+pub fn validate_entry_name(name: &str) -> Result<()> {
+    if name.is_empty() {
+        return Err(Error::UnsafeEntry {
+            path: name.to_string(),
+            detail: "entry name is empty".to_string(),
+        });
+    }
+    if name.starts_with('/') || name.starts_with('\\') {
+        return Err(Error::UnsafeEntry {
+            path: name.to_string(),
+            detail: "entry name starts with leading slash".to_string(),
+        });
+    }
+    let bytes = name.as_bytes();
+    if bytes.len() >= 2 && bytes[1] == b':' && (bytes[0].is_ascii_alphabetic()) {
+        return Err(Error::UnsafeEntry {
+            path: name.to_string(),
+            detail: "entry name contains drive letter".to_string(),
+        });
+    }
+    if name.chars().any(|c| c.is_control() || c == '\0') {
+        return Err(Error::UnsafeEntry {
+            path: name.to_string(),
+            detail: "entry name contains control or NUL characters".to_string(),
+        });
+    }
+    for comp in name.split(['/', '\\']) {
+        if comp == ".." {
+            return Err(Error::UnsafeEntry {
+                path: name.to_string(),
+                detail: "entry name contains path traversal '..'".to_string(),
+            });
+        }
+    }
+    Ok(())
+}
