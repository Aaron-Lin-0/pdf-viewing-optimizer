+fn write_outputs_exclusive(files: &[(PathBuf, Vec<u8>)]) -> Result<()> {
+    write_outputs_exclusive_with(files, std::io::Write::write_all)
+}
+
+fn write_outputs_exclusive_with<F>(files: &[(PathBuf, Vec<u8>)], mut write_fn: F) -> Result<()>
+where
+    F: FnMut(&mut fs::File, &[u8]) -> std::io::Result<()>,
+{
+    let mut written: Vec<PathBuf> = Vec::new();
+    let write_res: Result<()> = (|| {
+        for (path, bytes) in files {
+            let mut f = fs::OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .open(path)
+                .with_context(|| {
+                    format!(
+                        "exclusive creation of {} failed (file already exists or cannot be created)",
+                        path.display()
+                    )
+                })?;
+            written.push(path.clone());
+            write_fn(&mut f, bytes).with_context(|| format!("writing {}", path.display()))?;
+        }
+        Ok(())
+    })();
+
+    if let Err(e) = write_res {
+        for path in &written {
+            let _ = fs::remove_file(path);
+        }
+        return Err(e);
+    }
+    Ok(())
+}
